# Coffee-Dex Configuration
# Copy this to .env and fill in your values

# Neon Postgres connection string (Neon dashboard → Connection Details).
# Direct endpoint (hostname has no "-pooler") works with pgx defaults.
# If you switch to the pooled endpoint (-pooler), also add
# &default_query_exec_mode=exec — see docs/postgres-migration-guide.md.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx-000000.us-east-2.aws.neon.tech/neondb?sslmode=require
